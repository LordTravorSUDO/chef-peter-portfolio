# =============================================================================
# CHEF PETER PORTFOLIO — ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored. Never commit real secrets.
# On Vercel, add each variable in Project → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# CONTACT FORMS (Web3Forms — https://web3forms.com)
# Required for the contact form and consultation modal to send emails.
# Free tier available. Prefix VITE_ makes the key available to the browser bundle.
# -----------------------------------------------------------------------------
VITE_WEB3FORMS_ACCESS_KEY="YOUR_WEB3FORMS_ACCESS_KEY_HERE"

# -----------------------------------------------------------------------------
# SUPABASE — BROWSER-SAFE KEYS
# Required for all CMS functionality (articles, auth, media).
# Both VITE_ keys are intentionally browser-visible — Supabase RLS enforces
# access control server-side. The anon key alone grants only what RLS permits.
# Find these in: Supabase Dashboard → Project → Settings → API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# Optional — CMS image storage (see docs/storage-setup.md)
# Only set if the project's image bucket is NOT named "article-media":
# VITE_SUPABASE_MEDIA_BUCKET="article-media"
# Only set to true if the Supabase image-transformation add-on is enabled:
# VITE_SUPABASE_IMAGE_TRANSFORMS="false"

# -----------------------------------------------------------------------------
# SUPABASE — SERVER-ONLY KEYS (NO VITE_ PREFIX — never goes to the browser)
# Required by:
#   - Vercel Edge Middleware (middleware.ts) — for article metadata injection
#   - Vercel Serverless API routes (api/sitemap.ts, api/cron/publish-scheduled.ts)
# These MUST be set in Vercel Dashboard only — NOT in local .env for production.
# ⚠️ NEVER add a VITE_ prefix to these. That would bundle them into the JS.
#
# SUPABASE_URL: same host as VITE_SUPABASE_URL (without the trailing slash)
# SUPABASE_SERVICE_ROLE_KEY: from Supabase → Settings → API → service_role key
#   This key bypasses Row Level Security. Treat it like a database password.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# -----------------------------------------------------------------------------
# CRON_SECRET — Vercel Cron job authentication
# Required by: api/cron/publish-scheduled.ts
# Vercel automatically sends Authorization: Bearer <CRON_SECRET> on cron calls.
# Generate: openssl rand -hex 32
# Add to Vercel Dashboard → Project → Settings → Environment Variables
# (Production + Preview only — NOT Development)
# -----------------------------------------------------------------------------
CRON_SECRET="YOUR_CRON_SECRET_HERE"

# -----------------------------------------------------------------------------
# AI STUDIO / GEMINI (template remnant — not used by the live site)
# Left here to avoid breaking any AI Studio environment injection.
# -----------------------------------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
APP_URL="YOUR_APP_URL_HERE"
