# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WEB3FORMS_ACCESS_KEY: Required for the contact forms to send email submissions.
# 1. Get your free access key at https://web3forms.com
# 2. Copy it and create a .env file in the project root (it is gitignored).
# 3. Add the line below with your real key replacing the placeholder.
# 4. On Vercel: add VITE_WEB3FORMS_ACCESS_KEY as an Environment Variable in your project settings.
VITE_WEB3FORMS_ACCESS_KEY="YOUR_WEB3FORMS_ACCESS_KEY_HERE"
