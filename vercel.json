{
  "rewrites": [
    {
      "source": "/private-chef-uganda",
      "destination": "/private-chef-uganda.html"
    },
    {
      "source": "/culinary-consultant-uganda",
      "destination": "/culinary-consultant-uganda.html"
    },
    {
      "source": "/cooking-classes-kampala",
      "destination": "/cooking-classes-kampala.html"
    },
    {
      "source": "/baking-pastry-classes",
      "destination": "/baking-pastry-classes.html"
    },
    {
      "source": "/hospitality-consultancy",
      "destination": "/hospitality-consultancy.html"
    },
    {
      "source": "/about-chef-peter",
      "destination": "/about-chef-peter.html"
    },
    {
      "source": "/culinary-books",
      "destination": "/culinary-books.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
