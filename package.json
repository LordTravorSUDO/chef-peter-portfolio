{
  "name": "chef-peter-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --ssr src/prerender-entry.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e:build": "VITE_SUPABASE_URL=https://testref.supabase.co VITE_SUPABASE_ANON_KEY=test-anon-key vite build --outDir node_modules/.cache/e2e-dist --emptyOutDir",
    "test:e2e": "node tests/e2e/cms-editor.test.cjs node_modules/.cache/e2e-dist && node tests/e2e/cms-management.test.cjs node_modules/.cache/e2e-dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.50.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-image": "2.22.0",
    "@tiptap/extension-link": "2.22.0",
    "@tiptap/extension-placeholder": "2.22.0",
    "@tiptap/extension-underline": "2.22.0",
    "@tiptap/react": "2.22.0",
    "@tiptap/starter-kit": "2.22.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "6.30.6",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vercel/node": "5.1.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
